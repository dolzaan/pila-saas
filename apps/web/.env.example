# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Número oficial do WhatsApp do Pila no formato internacional, somente dígitos.
# Exemplo: 5547999999999
NEXT_PUBLIC_PILA_WHATSAPP_NUMBER=

# Token criado pelo Pila para a verificação do webhook da Meta.
# O mesmo valor deve ser informado no campo "Token de verificação" da Meta.
META_WHATSAPP_VERIFY_TOKEN=
